rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.get('email', '') == 'awoyinfasolomon1@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function isSuspendedUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'suspended'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true
        );
    }

    function isNotSuspended() {
      return isSignedIn() && !isSuspendedUser();
    }

    // --- USERS ---
    // Public read so usernames/fullNames/profiles and seller info load without permission errors.
    // Writes stay locked down so users can only edit their own safe profile fields (never isVerified/roles/status/email/isBanned).
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('roles', {}) is map
        && request.resource.data.get('roles', {}).get('admin', false) == false
        && request.resource.data.get('uid', userId) == userId
        && request.resource.data.get('email', '') == request.auth.token.get('email', '')
      );
      allow update: if isAdmin() || (
        isOwner(userId)
        && !isSuspendedUser()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'roles', 'status', 'uid', 'email', 'isBanned'])
      );
      allow delete: if isAdmin();

      // Legacy user-scoped subcollections
      match /favorites/{favId} {
        allow read: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow write: if (isNotSuspended() && isOwner(userId)) || isAdmin();
      }
      match /notifications/{notifId} {
        allow read: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow update, delete: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow create: if isNotSuspended();
      }
    }

    // --- VERIFICATION REQUESTS ---
    match /verification_requests/{requestId} {
      allow get: if isAdmin() || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isNotSuspended() && resource.data.userId == request.auth.uid);
      allow create: if isNotSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // --- PRODUCTS (Marketplace Items & Services) ---
    match /products/{id} {
      allow get: if resource == null || resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.sellerId)) || isAdmin();
      allow list: if resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.sellerId)) || isAdmin();
      allow create: if isAdmin() || (
        isNotSuspended()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.isApproved == false
      );
      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.sellerId)
          && request.resource.data.sellerId == resource.data.sellerId
          && (
            request.resource.data.isApproved == false
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status', 'isActive'])
            )
          )
        )
        || (
          (!isSignedIn() || !isSuspendedUser())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount is number
          && request.resource.data.viewCount == (resource.data.get('viewCount', 0) is number ? resource.data.get('viewCount', 0) : 0) + 1
        )
        || (
          (!isSignedIn() || !isSuspendedUser())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount'])
          && request.resource.data.contactCount is number
          && request.resource.data.contactCount == (resource.data.get('contactCount', 0) is number ? resource.data.get('contactCount', 0) : 0) + 1
        );
      allow delete: if (isNotSuspended() && isOwner(resource.data.sellerId)) || isAdmin();
    }

    // --- SERVICES (Dedicated Services Collection) ---
    match /services/{id} {
      allow get: if resource == null || resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.providerId)) || isAdmin();
      allow list: if resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.providerId)) || isAdmin();
      allow create: if isAdmin() || (
        isNotSuspended()
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.isApproved == false
      );
      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.providerId)
          && request.resource.data.providerId == resource.data.providerId
          && (
            request.resource.data.isApproved == false
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive'])
            )
          )
        )
        || (
          (!isSignedIn() || !isSuspendedUser())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount is number
          && request.resource.data.viewCount == (resource.data.get('viewCount', 0) is number ? resource.data.get('viewCount', 0) : 0) + 1
        )
        || (
          (!isSignedIn() || !isSuspendedUser())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount'])
          && request.resource.data.contactCount is number
          && request.resource.data.contactCount == (resource.data.get('contactCount', 0) is number ? resource.data.get('contactCount', 0) : 0) + 1
        );
      allow delete: if (isNotSuspended() && isOwner(resource.data.providerId)) || isAdmin();
    }

    // --- ACCOMMODATIONS ---
    match /accommodations/{id} {
      allow get: if resource == null || resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
      allow list: if resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
      allow create: if isAdmin() || (
        isNotSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isApproved == false
      );
      allow update: if isAdmin() || (
        isNotSuspended()
        && isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          request.resource.data.isApproved == false
          || (
            request.resource.data.isApproved == resource.data.isApproved
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'status'])
          )
        )
      );
      allow delete: if (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
    }

    // --- ROOMMATE REQUESTS ---
    match /roommate_requests/{id} {
      allow get: if resource == null || resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.userId)) || isAdmin();
      allow list: if resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.userId)) || isAdmin();
      allow create: if isAdmin() || (
        isNotSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isApproved == false
      );
      allow update: if isAdmin() || (
        isNotSuspended()
        && isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && (
          request.resource.data.isApproved == false
          || (
            request.resource.data.isApproved == resource.data.isApproved
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'status'])
          )
        )
      );
      allow delete: if (isNotSuspended() && isOwner(resource.data.userId)) || isAdmin();
    }

    // --- STORES ---
    match /stores/{id} {
      allow get: if resource == null || resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
      allow list: if resource.data.isApproved == true || (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
      allow create: if isAdmin() || (
        isNotSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.isApproved == false
      );
      allow update: if isAdmin() || (
        isNotSuspended()
        && isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && (
          request.resource.data.isApproved == false
          || (
            request.resource.data.isApproved == resource.data.isApproved
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
          )
        )
      );
      allow delete: if (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
    }

    // --- FAVORITES (Top-level collection used by BuyerService) ---
    match /favorites/{favId} {
      allow get: if isAdmin() || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isNotSuspended() && resource.data.userId == request.auth.uid);
      allow create: if isNotSuspended() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isNotSuspended() && resource.data.userId == request.auth.uid);
    }

    // --- NOTIFICATIONS (Top-level collection used by NotificationService & Navbar) ---
    match /notifications/{notifId} {
      allow get: if isAdmin() || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isNotSuspended() && resource.data.userId == request.auth.uid);
      allow create: if isNotSuspended() && request.resource.data.get('isRead', false) == false;
      allow update, delete: if isAdmin() || (isNotSuspended() && resource.data.userId == request.auth.uid);
    }

    // --- ENQUIRIES ---
    match /enquiries/{id} {
      allow get: if isAdmin() || (isNotSuspended() && (resource == null || resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow list: if isAdmin() || (isNotSuspended() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow create: if isNotSuspended() && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- REPORTS ---
    match /reports/{id} {
      allow create: if isNotSuspended()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.get('status', 'open') == 'open';
      allow read, update, delete: if isAdmin();
    }

    // --- CATEGORIES ---
    match /productCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- PLATFORM SETTINGS ---
    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
