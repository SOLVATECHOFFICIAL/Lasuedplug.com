rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidId(docId) {
      return docId is string
        && docId.size() > 0
        && docId.size() <= 128
        && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasAdminEmailToken() {
      return 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email.lower() in [
          'awoyinfasolomon1@gmail.com',
          'relaxj550@gmail.com'
        ];
    }

    function hasAdminClaim() {
      return request.auth.token.get('admin', false) == true
        || (
          request.auth.token.get('role', '') is string
          && request.auth.token.get('role', '').lower() == 'admin'
        );
    }

    function isAdminDocData(userData) {
      return (
        'roles' in userData
        && userData.roles is map
        && userData.roles.get('admin', false) == true
      )
      || (
        userData.get('role', '') is string
        && userData.get('role', '').lower() == 'admin'
      )
      || userData.get('isAdmin', false) == true
      || userData.get('admin', false) == true;
    }

    function hasAdminUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && isAdminDocData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data);
    }

    function isAdmin() {
      return isSignedIn() && (
        hasAdminClaim()
        || hasAdminEmailToken()
        || hasAdminUserDoc()
      );
    }

    function isSuspendedUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'suspended'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true
        );
    }

    function isNotSuspended() {
      return isSignedIn() && !isSuspendedUser();
    }

    function isVerifiedUser() {
      return isNotSuspended()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isVerified', false) == true;
    }

    function canSetInitialApprovalStatus(data) {
      return data.get('isApproved', null) is bool
        && (
          data.isApproved == false
          || (data.isApproved == true && isVerifiedUser())
        );
    }

    function isValidCounterIncrement(field) {
      return resource.data.isApproved == true
        && (!isSignedIn() || !isSuspendedUser())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && request.resource.data[field] is number
        && request.resource.data[field] == (
          resource.data.get(field, 0) is number ? resource.data.get(field, 0) : 0
        ) + 1;
    }

    function isValidTrustScoreUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['trustScore', 'reviewCount', 'updatedAt'])
        && request.resource.data.trustScore is number
        && request.resource.data.trustScore >= 0
        && request.resource.data.trustScore <= 5
        && request.resource.data.reviewCount is number
        && request.resource.data.reviewCount >= 0;
    }

    function hasValidImagesArray(data) {
      return data.get('images', []) is list
        && data.images.size() >= 1
        && data.images.size() <= 4
        && data.images[0] is string
        && data.images[0].size() > 0;
    }

    function hasValidGpsCoordinates(data) {
      return data.get('latitude', null) is number
        && data.get('longitude', null) is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude >= -180
        && data.longitude <= 180;
    }

    function hasValidPhysicalLocationRule(data) {
      return data.get('locationType', 'online') != 'physical'
        || hasValidGpsCoordinates(data);
    }

    // =========================================================================
    // ADMIN GOD-MODE OVERRIDE (Full read/write/delete across entire database)
    // Once authenticated as Admin, every Admin Dashboard action succeeds here.
    // =========================================================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // USERS & LEGACY USER SUBCOLLECTIONS
    // =========================================================================
    match /users/{userId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isValidId(userId)
        && isOwner(userId)
        && request.resource.data.get('isVerified', false) == false
        && request.resource.data.get('status', 'active') == 'active'
        && request.resource.data.get('isBanned', false) == false
        && request.resource.data.get('accountType', 'student') in ['student', 'business']
        && request.resource.data.get('trustScore', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0
        && request.resource.data.get('roles', {}) is map
        && request.resource.data.get('roles', {}).get('admin', false) == false
        && request.resource.data.get('uid', userId) == userId
        && request.resource.data.get('email', '').lower() == request.auth.token.get('email', '').lower()
      );

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && !isSuspendedUser()
          && (
            !('accountType' in resource.data)
            || request.resource.data.accountType == resource.data.accountType
          )
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'isVerified',
            'roles',
            'status',
            'uid',
            'email',
            'isBanned',
            'trustScore',
            'reviewCount'
          ])
        )
        || (
          isNotSuspended()
          && request.auth.uid != userId
          && isValidTrustScoreUpdate()
        );

      allow delete: if isAdmin();

      match /favorites/{favId} {
        allow read: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow write: if (isNotSuspended() && isOwner(userId)) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow update, delete: if (isNotSuspended() && isOwner(userId)) || isAdmin();
        allow create: if isNotSuspended() || isAdmin();
      }
    }

    // =========================================================================
    // VERIFICATION REQUESTS (Student ID / Fee Receipt)
    // =========================================================================
    match /verification_requests/{requestId} {
      allow get: if isAdmin()
        || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin()
        || (isNotSuspended() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (
        isValidId(requestId)
        && isNotSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && (
          (
            request.resource.data.get('idCardImage', '') is string
            && request.resource.data.idCardImage.size() > 0
          )
          || (
            request.resource.data.get('documentUrl', '') is string
            && request.resource.data.documentUrl.size() > 0
          )
        )
      );

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // PRODUCTS (Marketplace Items & Services)
    // =========================================================================
    match /products/{id} {
      allow get: if resource == null
        || resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.sellerId))
        || isAdmin();

      allow list: if resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.sellerId))
        || isAdmin();

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.sellerId == request.auth.uid
        && canSetInitialApprovalStatus(request.resource.data)
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.get('contactCount', 0) == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && hasValidImagesArray(request.resource.data)
        && hasValidPhysicalLocationRule(request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.sellerId)
          && request.resource.data.sellerId == resource.data.sellerId
          && (
            (
              request.resource.data.isApproved == false
              && request.resource.data.title is string
              && request.resource.data.title.size() >= 5
              && request.resource.data.title.size() <= 200
              && request.resource.data.description is string
              && request.resource.data.description.size() >= 5
              && request.resource.data.description.size() <= 5000
              && hasValidImagesArray(request.resource.data)
              && hasValidPhysicalLocationRule(request.resource.data)
            )
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'status', 'isActive', 'updatedAt'])
            )
          )
        )
        || isValidCounterIncrement('viewCount')
        || isValidCounterIncrement('contactCount');

      allow delete: if (isNotSuspended() && isOwner(resource.data.sellerId)) || isAdmin();
    }

    // =========================================================================
    // SERVICES (Legacy Dedicated Services Collection)
    // =========================================================================
    match /services/{id} {
      allow get: if resource == null
        || resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.providerId))
        || isAdmin();

      allow list: if resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.providerId))
        || isAdmin();

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.providerId == request.auth.uid
        && canSetInitialApprovalStatus(request.resource.data)
        && request.resource.data.get('viewCount', 0) == 0
        && request.resource.data.get('contactCount', 0) == 0
        && hasValidImagesArray(request.resource.data)
        && hasValidPhysicalLocationRule(request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.providerId)
          && request.resource.data.providerId == resource.data.providerId
          && (
            request.resource.data.isApproved == false
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'isActive', 'updatedAt'])
            )
          )
        )
        || isValidCounterIncrement('viewCount')
        || isValidCounterIncrement('contactCount');

      allow delete: if (isNotSuspended() && isOwner(resource.data.providerId)) || isAdmin();
    }

    // =========================================================================
    // ACCOMMODATIONS
    // =========================================================================
    match /accommodations/{id} {
      allow get: if resource == null
        || resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.ownerId))
        || isAdmin();

      allow list: if resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.ownerId))
        || isAdmin();

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && canSetInitialApprovalStatus(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && hasValidImagesArray(request.resource.data)
        && hasValidGpsCoordinates(request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            (
              request.resource.data.isApproved == false
              && request.resource.data.title is string
              && request.resource.data.title.size() >= 5
              && request.resource.data.title.size() <= 200
              && request.resource.data.description is string
              && request.resource.data.description.size() >= 5
              && request.resource.data.description.size() <= 5000
              && hasValidImagesArray(request.resource.data)
              && hasValidGpsCoordinates(request.resource.data)
            )
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'status', 'updatedAt'])
            )
          )
        )
        || isValidCounterIncrement('viewCount')
        || isValidCounterIncrement('contactCount');

      allow delete: if (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
    }

    // =========================================================================
    // ROOMMATE REQUESTS
    // =========================================================================
    match /roommate_requests/{id} {
      allow get: if resource == null
        || resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.userId))
        || isAdmin();

      allow list: if resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.userId))
        || isAdmin();

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.userId == request.auth.uid
        && canSetInitialApprovalStatus(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && hasValidImagesArray(request.resource.data)
        && hasValidGpsCoordinates(request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && (
            (
              request.resource.data.isApproved == false
              && request.resource.data.title is string
              && request.resource.data.title.size() >= 5
              && request.resource.data.title.size() <= 200
              && request.resource.data.description is string
              && request.resource.data.description.size() >= 5
              && request.resource.data.description.size() <= 5000
              && hasValidImagesArray(request.resource.data)
              && hasValidGpsCoordinates(request.resource.data)
            )
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'status', 'updatedAt'])
            )
          )
        )
        || isValidCounterIncrement('viewCount')
        || isValidCounterIncrement('contactCount');

      allow delete: if (isNotSuspended() && isOwner(resource.data.userId)) || isAdmin();
    }

    // =========================================================================
    // CAMPUS STORES
    // =========================================================================
    match /stores/{id} {
      allow get: if resource == null
        || resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.ownerId))
        || isAdmin();

      allow list: if resource.data.isApproved == true
        || (isNotSuspended() && isOwner(resource.data.ownerId))
        || isAdmin();

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.ownerId == request.auth.uid
        && canSetInitialApprovalStatus(request.resource.data)
        && request.resource.data.get('trustScore', 0) == 0
        && request.resource.data.get('reviewCount', 0) == 0
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 5
        && request.resource.data.name.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 5000
        && hasValidImagesArray(request.resource.data)
        && hasValidGpsCoordinates(request.resource.data)
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && isOwner(resource.data.ownerId)
          && request.resource.data.ownerId == resource.data.ownerId
          && (
            (
              request.resource.data.isApproved == false
              && request.resource.data.name is string
              && request.resource.data.name.size() >= 5
              && request.resource.data.name.size() <= 200
              && request.resource.data.description is string
              && request.resource.data.description.size() >= 5
              && request.resource.data.description.size() <= 5000
              && hasValidImagesArray(request.resource.data)
              && hasValidGpsCoordinates(request.resource.data)
            )
            || (
              request.resource.data.isApproved == resource.data.isApproved
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'status', 'updatedAt'])
            )
          )
        )
        || (
          resource.data.isApproved == true
          && isNotSuspended()
          && request.auth.uid != resource.data.ownerId
          && isValidTrustScoreUpdate()
        )
        || isValidCounterIncrement('viewCount')
        || isValidCounterIncrement('contactCount');

      allow delete: if (isNotSuspended() && isOwner(resource.data.ownerId)) || isAdmin();
    }

    // =========================================================================
    // FAVORITES (Saved Listings)
    // =========================================================================
    match /favorites/{favId} {
      allow get: if isAdmin()
        || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin()
        || (isNotSuspended() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (
        isValidId(favId)
        && isNotSuspended()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.listingId.size() <= 128
      );

      allow update, delete: if isAdmin()
        || (isNotSuspended() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notifId} {
      allow get: if isAdmin()
        || (isNotSuspended() && (resource == null || resource.data.userId == request.auth.uid));
      allow list: if isAdmin()
        || (isNotSuspended() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin() || (
        isValidId(notifId)
        && isNotSuspended()
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userId.size() <= 128
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.get('isRead', false) == false
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool
        );

      allow delete: if isAdmin()
        || (isNotSuspended() && resource.data.userId == request.auth.uid);
    }

    // =========================================================================
    // ENQUIRIES (WhatsApp Buyer <-> Seller History)
    // =========================================================================
    match /enquiries/{id} {
      allow get: if isAdmin() || (
        isNotSuspended()
        && (
          resource == null
          || resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
      );
      allow list: if isAdmin() || (
        isNotSuspended()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        )
      );

      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.listingId is string
        && request.resource.data.listingId.size() > 0
        && request.resource.data.listingId.size() <= 128
        && request.resource.data.get('listingTitle', '') is string
        && request.resource.data.get('listingTitle', '').size() <= 250
      );

      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // REVIEWS (Trust Score & Ratings for Sellers and Stores)
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if isAdmin() || (
        isValidId(reviewId)
        && isNotSuspended()
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.targetType in ['user', 'store']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 3
        && request.resource.data.comment.size() <= 1500
        && (
          request.resource.data.targetType != 'user'
          || request.resource.data.targetId != request.auth.uid
        )
      );

      allow update: if isAdmin()
        || (
          isNotSuspended()
          && resource.data.reviewerId == request.auth.uid
          && request.resource.data.reviewerId == resource.data.reviewerId
          && request.resource.data.targetId == resource.data.targetId
          && request.resource.data.targetType == resource.data.targetType
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() >= 3
          && request.resource.data.comment.size() <= 1500
        );

      allow delete: if isAdmin()
        || (isNotSuspended() && resource.data.reviewerId == request.auth.uid);
    }

    // =========================================================================
    // REPORTS (Content & User Moderation Reports)
    // =========================================================================
    match /reports/{id} {
      allow create: if isAdmin() || (
        isValidId(id)
        && isNotSuspended()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in [
          'product',
          'service',
          'accommodation',
          'roommate_request',
          'store',
          'user'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 2000
        && request.resource.data.get('status', 'open') == 'open'
      );

      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // CATEGORIES & PLATFORM SETTINGS
    // =========================================================================
    match /productCategories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // COMMUNITY SUGGESTIONS & FEEDBACK
    // =========================================================================
    match /suggestions/{id} {
      allow get, list: if isAdmin()
        || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);

      allow create: if isAdmin() || (
        isValidId(id)
        && (!isSignedIn() || !isSuspendedUser())
        && (
          !('userId' in request.resource.data)
          || (isSignedIn() && request.resource.data.userId == request.auth.uid)
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.title.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 10
        && request.resource.data.details.size() <= 1500
        && request.resource.data.get('status', 'new') == 'new'
      );

      allow update, delete: if isAdmin();
    }
  }
}
